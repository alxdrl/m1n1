{
  "name": "m1n1 (C/Asm/Rust)",
  "workspaceFolder": "/workspaces/m1n1",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "ms-vscode.cmake-tools"
      ]
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y build-essential cmake gdb rustc cargo",
  "remoteUser": "vscode"
}